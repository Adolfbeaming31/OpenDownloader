<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="#1E1E1E"
    android:focusable="true"
    android:clickable="true">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvReleaseTag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="v20.2-Nexus"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReleaseDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2023-10-15"
            android:textColor="#88FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvReleaseTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kodi Nexus Stable Release"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvReleaseDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Changelog: Bug fixes and improvements."
        android:textColor="#DDFFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="12dp"
        android:maxLines="4"
        android:ellipsize="end" />

    <!-- Assets Container Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available APK Files:"
        android:textColor="#88FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Dynamic Assets list -->
    <LinearLayout
        android:id="@+id/containerAssets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#121212">

    <!-- Left Sidebar Navigation Pane -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- App Logo & Title -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/app_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="8dp"
            android:contentDescription="OpenDownloader Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpenDownloader"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <!-- Navigation Buttons -->
        <Button
            android:id="@+id/navBrowser"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🌐 Browser"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:background="@drawable/button_focus_bg"
            android:focusable="true"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navDownloads"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="📥 Downloads"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:background="@drawable/button_focus_bg"
            android:focusable="true"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navBookmarks"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="⭐ Bookmarks"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:background="@drawable/button_focus_bg"
            android:focusable="true"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navGitHub"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="☁️ GitHub Browser"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:background="@drawable/button_focus_bg"
            android:focusable="true"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navUpdater"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🔄 App Updater"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:background="@drawable/button_focus_bg"
            android:focusable="true" />

    </LinearLayout>

    <!-- Right Content Frame -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#121212" />

</LinearLayout>
